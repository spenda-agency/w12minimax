# MiniMax API 認証情報
# 1. https://platform.minimax.io/ （中国本土アカウントは https://platform.minimaxi.com/）にログイン
# 2. アカウント → API キー で発行
# 3. このファイルを `.env` にコピーして値を入れる（.env は .gitignore 済み。絶対にコミットしない）

MINIMAX_API_KEY=sk-cp-5TmG5RFQqbzFgSFeKBj81fRMC7JF-DIHFB1T7UEVqn_CquPvORmzFR93KoCjAmBdsK_1OF27KqbZa1xt4I51elaGVI9czI1kofJZ-5zaxqfZqN6zNw9Faxk
# GroupId は動画ファイルのダウンロードと音声合成で必要。コンソールのアカウント情報に表示される。
MINIMAX_GROUP_ID=2098026133294419980

# global = https://api.minimax.io/v1 （海外版） / cn = https://api.minimax.chat/v1 （中国本土版）
# キーは発行したリージョンでしか使えない。認証エラー(1004)が出たらここを疑う。
MINIMAX_REGION=global

# 任意: ベースURLを直接上書きしたい場合
# MINIMAX_BASE_URL=

# 任意: 生成物の出力先（既定: ./out）
# MINIMAX_OUT_DIR=

# 任意: HTTP まわり
MINIMAX_TIMEOUT=120
MINIMAX_MAX_RETRIES=4
